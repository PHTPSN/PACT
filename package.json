{
  "name": "pact-multisig-treasury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude tests/milestone1/base-sepolia.integration.test.ts --exclude tests/milestone2/base-sepolia.integration.test.ts",
    "test:integration": "node --env-file=.env --use-env-proxy node_modules/vitest/vitest.mjs run tests/milestone1/base-sepolia.integration.test.ts tests/milestone2/base-sepolia.integration.test.ts",
    "test:milestone1-live": "node --env-file=.env --use-env-proxy node_modules/vitest/vitest.mjs run tests/milestone1/base-sepolia.integration.test.ts",
    "test:milestone2-live": "node --env-file=.env --use-env-proxy node_modules/vitest/vitest.mjs run tests/milestone2/base-sepolia.integration.test.ts",
    "setup:milestone1": "npm run build --silent && node --env-file=.env --use-env-proxy dist/scripts/setup/milestone1Accounts.js",
    "demo:milestone1": "npm run build --silent && node --env-file=.env --use-env-proxy dist/scripts/demo/milestone1.js",
    "check:milestone2-capabilities": "npm run build --silent && node --env-file=.env --use-env-proxy dist/scripts/setup/checkCdpCapabilities.js",
    "server:milestone2": "npm run build --silent && node --env-file=.env --use-env-proxy dist/scripts/server/milestone2.js",
    "demo:milestone2": "npm run build --silent && node --env-file=.env --use-env-proxy dist/scripts/demo/milestone2.js"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.57.0",
    "@safe-global/protocol-kit": "8.0.7",
    "@safe-global/safe-deployments": "1.37.63",
    "@safe-global/types-kit": "4.0.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/express": "2.27.0",
    "@x402/extensions": "2.27.0",
    "@x402/fetch": "2.27.0",
    "@x402/svm": "2.27.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "viem": "2.57.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
